{
  "name": "henergyqueai-desktop",
  "productName": "HenergyqueAI",
  "version": "1.0.1",
  "description": "L'application de bureau HenergyqueAI pour Windows et macOS.",
  "author": "HenergyqueAI",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "fetch-model": "node scripts/fetch-model.mjs",
    "test": "node --test test/*.test.js",
    "test:app": "node test/app.mjs",
